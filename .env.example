# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# ---------- App database (your own Supabase project) ----------
# Supabase dashboard -> Connect -> "Session pooler" connection string.
# Then run server/db/migrations.sql once in the Supabase SQL Editor.
POSTGRES_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# ---------- TLS for Postgres connections ----------
# Certificates are verified by default. Supabase uses its own CA, so either:
#  (a) download it from Supabase dashboard -> Database settings -> SSL
#      Configuration -> "Download certificate", and paste its contents here
#      with newlines written as \n, or
#  (b) for local development only, turn verification off.
# PG_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# PG_SSL_REJECT_UNAUTHORIZED=false

# ---------- GitHub OAuth ----------
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ---------- Auth ----------
# Any long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change_me

# Optional: database analyzed by /api/query/analyze for users who have not
# connected their own database yet.
# DEFAULT_DATABASE_URL=
