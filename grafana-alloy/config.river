// Grafana Alloy pipeline for QueryHawk
//
//   metrics: backend:/api/metrics --scrape--> Mimir   (Grafana reads Mimir)
//   traces:  backend --OTLP--> Alloy :14317/:14318 --> Jaeger (embedded in UI)

logging {
  level  = "info"
  format = "logfmt"
}

// ---------- Metrics ----------

// Prometheus metrics scraping from backend (multi-user)
prometheus.scrape "backend_multi_user" {
  targets = [{
    __address__ = "backend:4002",
  }]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  metrics_path    = "/api/metrics"
  scrape_interval = "15s"
}

// Remote write to Mimir
prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }

  external_labels = {
    cluster     = "queryhawk",
    environment = "development",
  }
}

// ---------- Traces ----------

// Receives spans from the backend (OTEL_EXPORTER_OTLP_ENDPOINT points here)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:14317"
  }

  http {
    endpoint = "0.0.0.0:14318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.jaeger.input]
  }
}

// Jaeger all-in-one accepts OTLP gRPC on 4317 (COLLECTOR_OTLP_ENABLED=true)
otelcol.exporter.otlp "jaeger" {
  client {
    endpoint = "jaeger:4317"

    tls {
      insecure = true
    }
  }
}
